{
  "name": "osman-dashboard",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --parallel --no-bail --filter @osman/api --filter @osman/web dev",
    "build": "pnpm --filter @osman/shared build && pnpm --filter @osman/api build && pnpm --filter @osman/web build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @osman/api prisma generate",
    "db:migrate": "pnpm --filter @osman/api prisma migrate deploy",
    "seed": "pnpm --filter @osman/api seed",
    "test": "pnpm --filter @osman/api test",
    "test:e2e": "pnpm --filter @osman/shared build && pnpm --filter @osman/api build && pnpm --filter @osman/api test --testPathPattern=pipeline.e2e",
    "check:render": "node scripts/validate-render.mjs",
    "test:agent-contract": "pnpm --filter @osman/api test:agent-contract"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "prettier": "3.7.4",
    "yaml": "^2.9.1"
  }
}
