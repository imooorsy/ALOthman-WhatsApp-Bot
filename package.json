{
  "name": "osman-dashboard",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter @osman/shared build && pnpm --filter @osman/api build && pnpm --filter @osman/web build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @osman/api prisma generate",
    "db:migrate": "pnpm --filter @osman/api prisma migrate deploy",
    "seed": "pnpm --filter @osman/api seed",
    "test": "pnpm --filter @osman/api test",
    "test:agent-contract": "pnpm --filter @osman/api test:agent-contract"
  }
}
