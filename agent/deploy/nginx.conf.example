# The page over HTTPS in front of the server (deploy/README.md, step 4). Replace
# reception.example.sa with the office's name for it, and the certificate paths with its own.
# Written for nginx 1.24 (Ubuntu 24.04): "listen 443 ssl http2;" (the "http2 on;" directive
# needs nginx 1.25.1 or later).
server {
    listen 80;
    server_name reception.example.sa;

    # certbot renews the certificate over plain HTTP: its challenge files are served here, not
    # redirected (deploy/README.md, step 4).
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name reception.example.sa;

    ssl_certificate     /etc/letsencrypt/live/reception.example.sa/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/reception.example.sa/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Voice recordings for the quality page are the largest requests.
    client_max_body_size 30m;

    # The webhook is for Evolution on this machine only, never from outside.
    location /webhooks/ {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:3210;
        proxy_http_version 1.1;
        # The server checks the Host against PUBLIC_ORIGIN, and reads the client's address from
        # X-Forwarded-For (TRUST_PROXY=1) for the login limits.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
