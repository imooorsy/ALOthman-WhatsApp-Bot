# Copy to .env.local. Keys stay on this machine and are never returned to the UI.
# Never HOST=0.0.0.0: the server is reached through the TLS proxy only (deploy/README.md).
HOST=127.0.0.1
PORT=3210
APP_MODE=demo
# Required in live mode. Configure a TLS reverse proxy before remote access (deploy/README.md).
# Written as browsers send it: https://name, no path (a trailing slash is removed).
PUBLIC_ORIGIN=http://127.0.0.1:3210
# 1 when the TLS reverse proxy runs on this machine: the client's address is read from it.
TRUST_PROXY=
# Optional: where npm run backup writes (default: backups/ in the project folder). Outside
# /opt/elmaster/backups, allow it in the backup service too (deploy/README.md, step 8).
BACKUP_DIR=
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
# "text" for Evolution API v2, "textMessage" for v1.
EVOLUTION_TEXT_FORMAT=textMessage
WEBHOOK_SECRET=
# A trial on a test number (deploy/README.md): the test SIM's number, digits only with its country
# code. While it is the number linked, the assistant answers without a passing evaluation; linked
# to any other number it does not. Empty: no trial.
TRIAL_NUMBER=
# Which service answers for the model: "anthropic" (Anthropic's API) or "openrouter" (another
# maker's model through OpenRouter, server/openrouter.js). Each reads its own key and model below.
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Enter an exact model identifier available to your Anthropic account.
ANTHROPIC_MODEL=
ANTHROPIC_VERSION=2023-06-01
# With MODEL_PROVIDER=openrouter: the key, and OpenRouter's exact model identifier (openai/gpt-6-luna).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OpenRouter only: "on" asks the understanding in two requests sent together; the default is one.
MODEL_SPLIT=off
# 6 seconds: after it the client gets the welcome and is passed to the staff.
MODEL_TIMEOUT_MS=6000
# Anthropic only. How long the provider keeps the model's instructions cached: 1h (default) or 5m.
PROMPT_CACHE_TTL=1h
# The model writes each approved reply in natural words; "off" sends the approved texts as they are.
PHRASING=on
# Optional: another exact model identifier for the writing; empty uses the model above.
PHRASING_MODEL=
# After this, the approved text is sent as it is.
PHRASING_TIMEOUT_MS=5000
# How the conversation is run (the project owner's decision of 18 November 2026): "agent" (the
# default) has the model run it with the office's file ai/prompts/office.md, every reply checked by
# ai/src/agent-guard.js; "flow" is the code's triage built from the earlier knowledge base. The
# model runs it only through OpenRouter (MODEL_PROVIDER=openrouter).
CONVERSATION=agent
# Optional: another model for it (the understanding's model by default), how much it reasons first
# (none, minimal, low, medium, high; low by default: medium repeated less but took 8 to 12 seconds),
# its timeout, its answer's length, and how many replies one conversation gets before the staff.
AGENT_MODEL=
AGENT_REASONING=low
AGENT_TIMEOUT_MS=20000
AGENT_MAX_TOKENS=4000
AGENT_MAX_REPLIES=40
# npm run eval:live: the exact model identifiers to measure, comma-separated, of the provider above.
EVAL_MODELS=
# Optional, for npm run eval:live: at most this many requests a minute (a new OpenRouter account
# is allowed 20 a minute for a model: 18 leaves room).
EVAL_RPM=
# Optional: the path of a held-out evaluation set kept OUTSIDE the repository (the office's real
# messages, labelled; ai/README.md says how it is made). When set, npm run eval:live grades it
# too and it gates the result; its failures are never printed or written, only counted.
HELD_OUT_SET=
# Optional: voice notes as text, through an OpenAI-compatible /audio/transcriptions endpoint
# (e.g. https://api.openai.com/v1). Without it a voice note is answered with a request for a
# short written summary, and the staff keep the recording (deploy/README.md, step 5).
# The model's gateway transcribes too: TRANSCRIBE_URL=https://openrouter.ai/api/v1 with
# TRANSCRIBE_MODEL=openai/whisper-large-v3, and TRANSCRIBE_API_KEY left empty (the gateway's own
# key, OPENROUTER_API_KEY, is used for it and for no other address).
TRANSCRIBE_URL=
TRANSCRIBE_API_KEY=
# The endpoint's exact model identifier, e.g. gpt-4o-mini-transcribe or whisper-1.
TRANSCRIBE_MODEL=
# Optional: "ar" when every voice note is Arabic; empty lets the service detect it.
TRANSCRIBE_LANGUAGE=
# Optional: "on" sends ai/prompts/transcribe.md as instructions (models that follow them; not Whisper).
TRANSCRIBE_PROMPT=
TRANSCRIBE_TIMEOUT_MS=15000
# Optional. Receives each alert as JSON: an Arabic "text" (Slack- and Teams-ready), its kind, the
# conversation id and the time; no client data. Test it from the settings page.
ALERT_WEBHOOK_URL=
# Optional: the day's exchange rates, for a claim in another currency (knowledge base 4.4,
# server/rates.js). Empty: https://open.er-api.com/v6/latest/USD, read once a day, no key, no
# client data in the request. "off" stops it: the dollar and the Gulf currencies pegged to it are
# still converted, any other currency goes to the team.
RATES_URL=
# Trials only (scripts/trials/try-model.js): keys for trying another provider's model on the
# evaluation, under the spending guard. The server reads neither. (The trials read
# OPENROUTER_API_KEY above too.)
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
