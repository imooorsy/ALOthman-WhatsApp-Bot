generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum Role {
 admin
 employee
}
enum ConversationStatus {
 agent_active
 human
 urgent
 waiting_schedule
 not_suitable
}
enum Direction {
 client
 agent
 staff
}
enum MessageType {
 text
 image
 audio
 document
 other
}
model StaffUser {
 id String @id @default(cuid())
 name String
 email String @unique
 passwordHash String
 role Role @default(employee)
 notifyPrefs Json @default("{\"sound\":true,\"desktop\":false,\"volume\":0.5}")
 conversations Conversation[]
 events ConversationEvent[]
 reads NotificationRead[]
}
model Client {
 id String @id @default(cuid())
 phone String @unique
 name String?
 detectedCategory String?
 shortDescription String?
 conversations Conversation[]
}
model Conversation {
 id String @id @default(cuid())
 clientId String
 client Client @relation(fields:[clientId],references:[id])
 status ConversationStatus @default(agent_active)
 assignedStaffId String?
 assignedStaff StaffUser? @relation(fields:[assignedStaffId],references:[id])
 category String?
 summary String?
 urgentReason String?
 unreadCount Int @default(0)
 lastClientMessageAt DateTime @default(now())
 lastActivityAt DateTime @default(now())
 version Int @default(0)
 messages Message[]
 events ConversationEvent[]
 notifications Notification[]
 @@index([status,lastActivityAt])
 @@index([clientId])
}
model Message {
 id String @id @default(cuid())
 conversationId String
 conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
 direction Direction
 type MessageType @default(text)
 text String
 waMessageId String? @unique
 deliveryStatus String @default("pending")
 agentConfigVersion Int?
 processedAt DateTime?
 createdAt DateTime @default(now())
 @@index([conversationId,createdAt])
}
model ConversationEvent {
 id String @id @default(cuid())
 conversationId String
 conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
 type String
 actorStaffId String?
 actorStaff StaffUser? @relation(fields:[actorStaffId],references:[id])
 payload Json
 createdAt DateTime @default(now())
 @@index([conversationId,createdAt])
}
model Notification {
 id String @id @default(cuid())
 type String
 conversationId String
 conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
 reason String
 createdAt DateTime @default(now())
 reads NotificationRead[]
 @@index([createdAt])
}
model NotificationRead {
 notificationId String
 notification Notification @relation(fields:[notificationId],references:[id],onDelete:Cascade)
 staffId String
 staff StaffUser @relation(fields:[staffId],references:[id],onDelete:Cascade)
 @@id([notificationId,staffId])
}
model OfficeSettings {
 id Int @id @default(1)
 data Json
 configVersion Int @default(1)
}
model Service {
 id String @id @default(cuid())
 name String
 price Decimal @db.Decimal(12,2)
 active Boolean @default(true)
 sort Int
}
model CaseCategory {
 id String @id @default(cuid())
 name String
 active Boolean @default(true)
 outOfScope Boolean @default(false)
 sort Int
}
