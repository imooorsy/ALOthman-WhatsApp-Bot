{
  "name": "@osman/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsc && node --watch dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "prisma": "prisma",
    "seed": "tsx prisma/seed.ts",
    "test": "jest --runInBand",
    "test:agent-contract": "tsx src/agent-contract.ts"
  },
  "dependencies": {
    "@osman/shared": "workspace:*",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/websockets": "^11.1.18",
    "@nestjs/platform-socket.io": "^11.1.18",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "6.19.0",
    "bcrypt": "^6.0.0",
    "class-validator": "^0.14.2",
    "class-transformer": "^0.5.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.4.0",
    "pino-http": "^10.5.0",
    "pg": "^8.16.3",
    "pg-boss": "^10.3.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prisma": "6.19.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
