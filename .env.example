NODE_ENV=development
DATABASE_URL=postgresql://osman:osman_local@localhost:54329/osman
PORT=4000
WEB_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_DOMAIN=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=مدير المكتب
SEED_ADMIN_PASSWORD=
WA_PROVIDER=mock
AGENT_MODE=mock
AGENT_API_KEY=
AGENT_URL=http://localhost:8000
AGENT_MODULE=../../agent/index.js
AGENT_TIMEOUT_MS=20000
AGENT_RETRIES=1
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_API_VERSION=v22.0
DEBOUNCE_MS=3000
ATTACHMENT_HANDOFF=true
NOTIFY_WAITING=true
NOTIFY_NOT_SUITABLE=false
# Optional: dedicated migrated PostgreSQL database for Jest e2e (never production).
TEST_DATABASE_URL=
# Firebase web configuration (public; copied into apps/web/.env.local).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# API only: absolute path to a private service-account JSON outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=
